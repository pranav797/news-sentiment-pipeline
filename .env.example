# Copy this file to `.env` and fill it in. `.env` is gitignored and excluded
# from Docker images — never commit it. In docker-compose only the worker
# receives it.

# Required: OpenAI key for headline sentiment scoring.
# Create one at https://platform.openai.com/ -> API keys. Set a monthly usage
# limit on the key's project there as a hard spend ceiling.
OPENAI_API_KEY=sk-...

# --- Deployment (docker-compose) ---------------------------------------------
# Public domain for the site. Point its DNS A/AAAA record at the server and
# Caddy provisions HTTPS automatically. Leave as localhost for a local trial.
DOMAIN=localhost

# Optional tuning (defaults shown).
# RATE_LIMIT_PER_MINUTE=60     # API requests per client IP per minute
# MAX_HEADLINES_PER_RUN=200    # caps OpenAI spend per pipeline cycle
# ENABLE_DOCS=true             # set false to hide /api/docs in production
